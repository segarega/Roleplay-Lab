{
  "name": "roleplay-lab",
  "version": "1.3.0",
  "description": "A side-by-side OpenAI-compatible model workbench for roleplay testing.",
  "main": "./out/main/index.js",
  "author": "segarega",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && electron-vite build",
    "test:roleplay": "node scripts/test-roleplay-context.mjs",
    "test:transport": "node scripts/test-roleplay-context.mjs && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && electron-vite build && node scripts/smoke-openai-transport.mjs",
    "package:win": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && electron-vite build && electron-builder --win portable --x64",
    "preview": "electron-vite preview"
  },
  "dependencies": {},
  "devDependencies": {
    "@electron-toolkit/tsconfig": "2.0.0",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "esbuild": "0.25.12",
    "lucide-react": "1.26.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "typescript": "5.9.3",
    "vite": "8.1.5"
  },
  "build": {
    "appId": "com.roleplaylab.desktop",
    "productName": "Roleplay Lab",
    "asar": true,
    "compression": "normal",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico",
      "artifactName": "Roleplay-Lab-${version}-Portable.${ext}"
    }
  }
}
